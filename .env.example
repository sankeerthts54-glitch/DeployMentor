# ═══════════════════════════════════════════
# Deploy Doctor — Environment Variables
# Copy this to .env and fill in YOUR values
# NEVER commit .env to the repo
# ═══════════════════════════════════════════

# ── LLM Provider (used by TrueForge, not by this MCP server) ──
OPENAI_API_KEY=your-openai-api-key-here

# ── Platform API Keys (each laptop only needs its own) ──

# Laptop 1: Render
RENDER_API_KEY=your-render-api-key-here

# Laptop 2: Hugging Face Spaces
HF_TOKEN=your-huggingface-token-here

# Laptop 3: Vercel
VERCEL_TOKEN=your-vercel-token-here

# Laptop 4: GitHub Pages
GITHUB_TOKEN=your-github-personal-access-token-here

# ── Optional: Daytona Sandbox ──
DAYTONA_API_KEY=your-daytona-api-key-here
